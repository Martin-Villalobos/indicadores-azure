# Copiar a .env (no se versiona). Elige el entorno y, si hace falta, pisa conexiones
# de config/entornos.toml. Cualquier variable definida aquí tiene prioridad sobre el archivo.

# dev  = MySQL y Azurite locales (docker compose), sin nube
# prod = Azure (main). Las claves de prod sólo van aquí o en los secretos de Azure.
ENTORNO=dev

# --- Sólo para prod (en dev ya vienen en config/entornos.toml) ---
# DB_USER=
# DB_PASSWORD=
# Bundle de certificados para TLS (en la imagen del job ya viene configurado)
# DB_SSL_CA=
# BLOB_CONNECTION_STRING=
# QUEUE_NAME=cargas-nuevas

# --- Opcionales ---
# DB_HOST=localhost
# DB_PORT=3306
# CONFIG_ENTORNOS=config/entornos.toml
