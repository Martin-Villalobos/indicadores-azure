// Modelo de datos de indicadores-azure (MySQL).
// Fuente de verdad del diagrama: editar aquí y regenerar modelo.svg (ver README.md).
// Ver en vivo: pegar este archivo en https://dbdiagram.io/d
//
// Capas:
//   control   -> qué archivo entró, qué rango de fechas rige y qué cálculo se corrió con qué entradas
//   raw       -> archivos tal como vienen (una tabla por tipo de archivo)
//   maestros  -> dimensiones compartidas por todos los indicadores
//   programa  -> lo exigido por el PO / PE (Anexo 3)
//   operacion -> lo realizado (expediciones) y los eventos exógenos
//   icfp      -> detalle propio del ICFP (Contrato 5.3.1.6)
//   resultado -> tabla genérica de resultados para cualquier indicador
//
// Para sumar un indicador nuevo: una fila en `indicador`, sus parámetros en
// `parametro`, sus entradas raw si son nuevas, una tabla de detalle propia si
// la necesita (como icfp_sspd) y sus agregados en `resultado_indicador`.
//
// Equivalencias con la base indicadores_bi (indicadores-bi, Python):
//   control_carga        ~ control_ejecucion
//   tipo_archivo         ~ programa_ejecucion (generalizado a todos los archivos)
//   vigencia_archivo     ~ vigencia_programa_ejecucion (generalizado a todos los archivos)
//   programa_periodo     ~ detalle_programacion_periodo (+ programacion_periodo_origen)
//   expedicion           ~ fact_expedicion
//   calculo              ~ control_calculo_icf_icp / control_correccion_icf_icp
//   icfp_sspd            ~ fact_icf_icp_inicial (+ correcciones)
//   parametro            ~ dim_parametro_ite
//
// Reemplazo de archivos y recálculo:
//   1. Se carga un archivo -> control_carga.
//   2. Se registra su rango en vigencia_archivo: los tramos vigentes del mismo tipo que se
//      cruzan quedan vigente = 0 y, si sobraba una parte antes o después, se recrea como tramo
//      nuevo (igual que registrar_vigencia_programa de indicadores-bi, pero sin borrar historia).
//   3. Por cada indicador que usa ese tipo (indicador_fuente) se encola el rango en
//      recalculo_pendiente.
//   4. El worker corre un calculo nuevo solo para ese rango; las fechas recalculadas pasan a
//      leerse del calculo nuevo (v_calculo_vigente) y el resto sigue en el anterior.

Project indicadores_azure {
  database_type: 'MySQL'
  Note: 'Cálculo de indicadores del contrato (ICFP primero) para la U16, a partir de archivos DTPM.'
}

// ───────────────────────────── control ─────────────────────────────

Enum estado_carga {
  PROCESANDO
  COMPLETADO
  ERROR
}

Enum estado_calculo {
  EN_CURSO
  PROVISORIO [note: 'calculado con datos incompletos o antes del cierre del mes']
  DEFINITIVO
  ERROR
  REEMPLAZADO
}

Enum estado_recalculo {
  PENDIENTE
  EN_CURSO
  HECHO
  ERROR
}

Table tipo_archivo {
  codigo varchar(40) [pk, note: 'anexo1, anexo3, velocidades, exclusiones... (= carpeta del blob)']
  nombre varchar(100) [not null]
  cobertura varchar(10) [not null, note: 'RANGO (anexos: vigencia del PO/PE) | DIA (velocidades) | MES (exógenos)']
  Note: 'Catálogo de tipos de archivo. Generaliza programa_ejecucion de indicadores-bi.'
}

Table control_carga {
  carga_id bigint [pk, increment]
  tipo_archivo varchar(40) [not null, ref: > tipo_archivo.codigo]
  nombre_archivo varchar(255) [not null]
  blob_nombre varchar(400) [not null, note: 'ruta del archivo en el contenedor cargas: <tipo>/procesados/... o <tipo>/errores/...']
  hash_sha256 char(64) [not null]
  estado estado_carga [not null]
  subido_por varchar(255)
  inicio_at datetime [not null]
  fin_at datetime
  filas_leidas int
  filas_cargadas int
  mensaje_error text

  indexes {
    (tipo_archivo, hash_sha256) [unique, name: 'uq_control_carga_tipo_hash']
    (estado, inicio_at) [name: 'ix_control_carga_estado']
  }
  Note: 'Un registro por archivo procesado por el job (tipo + contenido).'
}

Table vigencia_archivo {
  vigencia_id bigint [pk, increment]
  tipo_archivo varchar(40) [not null, ref: > tipo_archivo.codigo]
  carga_id bigint [not null, ref: > control_carga.carga_id]
  fecha_inicio date [not null]
  fecha_termino date [not null]
  rango_desde date [not null, note: 'rango completo de la carga (decide quién gana)']
  rango_hasta date [not null]
  vigente boolean [not null, default: true]
  reemplazada_por bigint [ref: > control_carga.carga_id, note: 'carga que tapó este tramo']
  origen varchar(10) [not null, default: 'CARGA', note: 'CARGA (al subir el archivo) | MANUAL (cambiada desde la web)']
  creado_por varchar(255) [note: 'usuario de la web si es MANUAL']
  creado_at datetime [not null]
  reemplazado_at datetime

  indexes {
    (tipo_archivo, vigente, fecha_inicio, fecha_termino) [name: 'ix_vigencia_rango']
  }
  Note: '''Qué carga rige cada fecha, por tipo de archivo. Regla: entre filas vigentes del mismo tipo
los rangos no se cruzan, así que para (tipo, fecha) hay a lo sumo una carga vigente.
Todos los anexos son iguales; solo cambian sus fechas. Regla al registrar una carga, por cada fecha:
  - gana el archivo cuyo rango completo es más corto (el más específico);
  - si el rango es igual, gana el cargado después (corrección del mismo anexo).
Así un anexo de 18-19 sep manda sobre uno de jul-nov aunque el de jul-nov se recargue después.
Ej.: jul-nov + 18-19 sep -> jul-17sep (jul-nov), 18-19sep (18-19 sep), 20sep-nov (jul-nov).
Las filas reemplazadas quedan con vigente = 0 como historia.
La web lista las filas vigentes por tipo de archivo (y su historia) y permite reasignar un rango
a otra carga ya subida: se registra con origen = MANUAL y encola el recálculo igual que una carga.'''
}

Table indicador {
  codigo varchar(20) [pk, note: 'ICFP, ITE, IE, IP...']
  nombre varchar(200) [not null]
  Note: 'Catálogo de indicadores. Agregar uno nuevo es agregar una fila aquí.'
}

Table indicador_fuente {
  indicador varchar(20) [ref: > indicador.codigo]
  tipo_archivo varchar(40) [ref: > tipo_archivo.codigo]
  desfase_dias smallint [not null, default: 0, note: '1 si un cambio en d afecta d-1 y d+1 (trasvasije)']

  indexes {
    (indicador, tipo_archivo) [pk]
  }
  Note: 'De qué tipos de archivo depende cada indicador (ICFP: anexo3, velocidades, exclusiones, flota).'
}

Table recalculo_pendiente {
  recalculo_id bigint [pk, increment]
  indicador varchar(20) [not null, ref: > indicador.codigo]
  fecha_desde date [not null]
  fecha_hasta date [not null]
  motivo_carga_id bigint [ref: > control_carga.carga_id, note: 'archivo que lo gatilló; NULL = cambio en datos maestros']
  estado varchar(12) [not null, note: 'PENDIENTE | HECHO | ERROR']
  calculo_id bigint [ref: > calculo.calculo_id, note: 'cálculo que lo resolvió']
  creado_at datetime [not null]
  resuelto_at datetime
  Note: 'Cola de recálculos. La llena el job al completar una carga y la web al editar datos maestros; el job junta los rangos que se tocan en un solo cálculo.'
}

Table calculo {
  calculo_id bigint [pk, increment]
  indicador varchar(20) [not null, ref: > indicador.codigo]
  fecha_desde date [not null]
  fecha_hasta date [not null]
  version_algoritmo varchar(50) [not null, note: 'ICFP_HORA_V1']
  estado varchar(12) [not null, note: 'PROCESANDO | OK | ERROR']
  inicio_at datetime [not null]
  fin_at datetime
  fechas_calculadas int
  mensaje_error text [note: 'también las fechas omitidas (sin Anexo 3 vigente para su tipo de día)']

  indexes {
    (indicador, estado, fecha_desde) [name: 'ix_calculo_indicador']
  }
  Note: 'Cada corrida de un indicador. Nunca se sobrescribe: un recálculo es un calculo nuevo.'
}

Table calculo_entrada {
  calculo_id bigint [ref: > calculo.calculo_id]
  fecha date [not null]
  tipo_archivo varchar(40) [not null, ref: > tipo_archivo.codigo]
  carga_id bigint [not null, ref: > control_carga.carga_id]

  indexes {
    (calculo_id, fecha, tipo_archivo) [pk]
  }
  Note: 'Qué carga se usó para cada fecha del cálculo. Si hoy vigencia_archivo dice otra cosa, ese cálculo quedó obsoleto.'
}

Table parametro {
  parametro_id int [pk, increment]
  indicador varchar(20) [ref: > indicador.codigo, note: 'NULL = parámetro común']
  nombre varchar(40) [not null, note: 'FT_OFFLINE, PLAZAS_A, X_IE1, A_ITE...']
  vigente_desde date [not null]
  vigente_hasta date
  valor decimal(18,10) [not null]
  fuente varchar(200)

  indexes {
    (nombre, vigente_desde) [unique]
  }
  Note: 'PENDIENTE (aún no implementada). Generaliza dim_parametro_ite: constantes con vigencia (pueden cambiar por oficio).'
}

// ───────────────────────────── raw ─────────────────────────────

Table raw_anexo1 {
  id bigint [pk, increment]
  carga_id bigint [not null, ref: > control_carga.carga_id]
  numero_fila int [not null]
  unidad_servicios varchar(40)
  anio smallint
  codigo_ts_servicio varchar(20) [not null]
  codigo_usuario_servicio varchar(20)
  sentido varchar(20) [not null]
  tipo_dia varchar(20) [not null]
  tramo_horario smallint
  hora_inicio time [not null]
  hora_termino time
  fecha_inicio date
  fecha_termino date

  indexes {
    carga_id [name: 'ix_raw_anexo1_carga']
    (codigo_ts_servicio, sentido, tipo_dia) [name: 'ix_raw_anexo1_servicio']
  }
  Note: 'Anexo 1 tal como viene en el archivo, una fila por tramo.'
}

Table raw_anexo3 {
  id bigint [pk, increment]
  carga_id bigint [not null, ref: > control_carga.carga_id]
  numero_fila int [not null]
  hoja varchar(100) [not null]
  anio smallint
  fecha_inicio date [not null, note: 'cabecera FECHA INICIO = vigencia']
  fecha_termino date [not null]
  unidad_de_servicio varchar(40) [not null]
  codigo_ts_servicio varchar(20) [not null]
  codigo_usuario_servicio varchar(20)
  sentido varchar(20) [not null]
  tipo_dia varchar(20) [not null]
  mh time [not null, note: 'media hora']
  velocidad_km_hora decimal(8,2)
  distancia_base_km decimal(10,3)
  distancia_total_km decimal(10,3)
  numero_salidas int
  capacidad_plazas int
  agrupacion_mh varchar(40)
  familia_servicios varchar(40)
  indicador_tiempo_espera varchar(10)
  Note: 'Anexo 3 del PO o de un Programa Especial, una fila por media hora.'
}

Table raw_velocidades {
  id bigint [pk, increment]
  carga_id bigint [not null, ref: > control_carga.carga_id]
  numero_fila int [not null]
  un varchar(20) [not null]
  operador varchar(80)
  servicio varchar(20) [not null]
  patente varchar(12)
  sentido varchar(20) [not null]
  inicio time [not null]
  intervalo_salida time
  control time
  fin time
  distancia_m decimal(14,3)
  tiempo time
  velocidad_km_hr decimal(12,6)
  capacidad int
  estado varchar(10) [not null, note: 'OK / NOK...']
  fecha date [not null, note: '= vigencia (un día)']
  dia tinyint
  tipo_dia varchar(20) [not null]
  periodo varchar(60)
  cada_5_minutos time
  cada_media_hora time
  Note: 'Archivo diario de velocidades DTPM (hoja velocidad), una fila por expedición. Sólo U16.'
}

Table raw_exclusiones {
  id bigint [pk, increment]
  carga_id bigint [not null, ref: > control_carga.carga_id]
  hoja varchar(20) [not null, note: 'ICFP-IE | IP-Base | IP-Extra']
  numero_fila int [not null]
  fecha date [not null]
  unidad_servicios varchar(10) [not null, note: 'U16']
  codigo_ts_servicio varchar(20) [not null, note: '* = todos']
  sentido varchar(20) [not null, note: '* = todos']
  periodo varchar(10) [note: 'ICFP-IE: 1-72 (hora por tipo de día) o *']
  id_expedicion varchar(40) [note: 'IP-Base']
  correlativo_paradero varchar(20) [note: 'IP-Base']
  Note: '''Exclusiones mensuales del DTPM por eventos exógenos (archivo MMM-AAAA-Exclusiones.xlsx).
Vigencia: los meses completos que cubren sus fechas.'''
}

// ───────────────────────────── maestros ─────────────────────────────

Table dim_servicio_terminal {
  codigo_usuario varchar(20) [pk]
  terminal varchar(60) [not null, note: 'Los Sauces, Gabriela...']
  actualizado_por varchar(255)
  actualizado_at datetime
  Note: 'Terminal de cada servicio (maestro servicios_terminales.csv de indicadores-bi). Editable en la web (Datos maestros).'
}

Table dim_servicio_sentido {
  servicio_sentido_id int [pk, increment]
  terminal varchar(60) [note: 'de dim_servicio_terminal por código usuario']
  codigo_ts varchar(20) [not null, note: 'normalizado: sin espacios, mayúsculas']
  codigo_usuario varchar(20)
  sentido char(1) [not null, note: 'I / R']

  indexes {
    (codigo_ts, sentido) [unique]
  }
  Note: 'PENDIENTE (aún no implementada). s del contrato. Normaliza el código una sola vez para que anexo y velocidades crucen.'
}

Table dim_fecha {
  fecha date [pk]
  mes date [not null, note: 'primer día del mes (T)']
  dia_semana tinyint [not null]
  tipo_dia_calendario varchar(10) [not null, note: 'LABORAL / SABADO / DOMINGO (feriado = DOMINGO)']
  es_feriado boolean [not null, default: false]
  Note: 'PENDIENTE (aún no implementada). Calendario. El tipo de día operativo sale de las velocidades del día.'
}

Table dim_tipologia_bus {
  tipologia varchar(5) [pk, note: 'A1, A2, B1, B2, C1, C2']
  plazas smallint [not null, note: 'Contrato Tabla 5: A=60, B=90, C=150 (debe calzar con bi.tipo_bus.capacidad)']
  Note: 'PENDIENTE (aún no implementada).'
}

Table dim_bus {
  ppu varchar(12) [pk, note: 'sin guiones, mayúsculas']
  tipo_bus varchar(40)
  plazas smallint [note: 'NULL = sin capacidad: el ICP de esa hora no se puede medir']
  origen varchar(10) [not null, note: 'CARGA (archivo de flota) | MANUAL (web)']
  carga_id bigint [ref: > control_carga.carga_id]
  actualizado_por varchar(255)
  actualizado_at datetime
  Note: 'Flota = bi.buses + bi.tipo_bus. La llena cada carga de flota y se corrige en la web. El ICP nunca usa la capacidad de velocidades.'
}

Table raw_flota {
  id bigint [pk, increment]
  carga_id bigint [not null, ref: > control_carga.carga_id]
  numero_fila int [not null]
  ppu varchar(12) [not null]
  tipo_bus varchar(40)
  plazas smallint
  Note: 'Archivo de flota (CSV o Excel: ppu, tipo_bus, capacidad). Al completar se copia a dim_bus.'
}

Table dim_periodo {
  periodo_id smallint [pk, increment]
  esquema varchar(20) [not null, note: 'MH (contrato) | AGRUPACION_MH (si el Ministerio agrupa por oficio) | HORA (Java / indicadores-bi actual)']
  codigo varchar(20) [not null]
  hora_inicio time [not null]
  hora_termino time [not null]
  orden smallint [not null, note: 'para ubicar p-1 y p+1']

  indexes {
    (esquema, codigo) [unique]
  }
  Note: 'PENDIENTE (aún no implementada). p del contrato: la media hora (Anexo 3 C.2), agrupable por oficio. El cálculo elige el esquema y lo guarda en calculo.parametros.'
}

// ───────────────────────────── programa ─────────────────────────────

Table programa_periodo {
  programa_periodo_id bigint [pk, increment]
  carga_id bigint [not null, ref: > control_carga.carga_id, note: 'carga del Anexo 3 (PO o PE)']
  servicio_sentido_id int [not null, ref: > dim_servicio_sentido.servicio_sentido_id]
  tipo_dia varchar(10) [not null]
  periodo_id smallint [not null, ref: > dim_periodo.periodo_id]
  longitud_km decimal(10,3) [not null, note: 'L s,p']
  expediciones_programadas int [not null, note: 'Σb ep']
  plazas_programadas int [not null, note: 'Σb pl_prog']

  indexes {
    (carga_id, servicio_sentido_id, tipo_dia, periodo_id) [unique]
  }
  Note: 'PENDIENTE (aún no implementada). Exigencia por servicio-sentido-periodo y tipo de día. Con esquema MH es 1:1 con las filas del Anexo 3.'
}

Table programa_periodo_tipologia {
  programa_periodo_id bigint [ref: > programa_periodo.programa_periodo_id]
  tipologia varchar(5) [ref: > dim_tipologia_bus.tipologia]
  expediciones_programadas int [not null, note: 'ep b,s,p']

  indexes {
    (programa_periodo_id, tipologia) [pk]
  }
  Note: 'PENDIENTE (aún no implementada). Opcional: desglose por tipo de bus (lo pide km válidos por tipo de bus / PKS).'
}

// ───────────────────────────── operacion ─────────────────────────────

Table expedicion {
  expedicion_id bigint [pk, increment]
  raw_velocidades_id bigint [not null, ref: > raw_velocidades.id]
  fecha date [not null, ref: > dim_fecha.fecha]
  servicio_sentido_id int [not null, ref: > dim_servicio_sentido.servicio_sentido_id]
  ppu varchar(12) [ref: > dim_bus.ppu, note: 'NULL si la patente no está en la flota']
  fh_salida datetime [not null]
  fh_llegada datetime
  periodo_id smallint [not null, ref: > dim_periodo.periodo_id, note: 'periodo de despacho']
  estado_origen varchar(10) [not null, note: 'estado del archivo de velocidades']
  valida boolean [not null, note: 'estado_origen = OK (cláusula 1.1.22)']
  plazas smallint [note: 'según tipología del bus']

  indexes {
    (fecha, servicio_sentido_id, periodo_id) [name: 'ix_expedicion_sspd']
  }
  Note: 'PENDIENTE (aún no implementada). Expedición realizada, normalizada y ya cruzada con flota. La comparten ICFP, ITE, IPK, Telemetría km...'
}

Table evento_exogeno {
  evento_id bigint [pk, increment]
  carga_id bigint [ref: > control_carga.carga_id]
  fecha date [not null, ref: > dim_fecha.fecha]
  tipo varchar(30) [not null, note: 'TECNOLOGICO_MAYOR | OPERACIONAL_SIMPLE | OPERACIONAL_COMPLEJO | OPERACIONAL_MAYOR']
  categoria varchar(60) [note: 'p. ej. Tráfico Recargado (define el aporte al FEO)']
  aceptado boolean [not null]
  observacion text
  Note: 'PENDIENTE (aún no implementada). Eventos exógenos aceptados por DTPM (Manual de Eventos Exógenos).'
}

Table evento_exclusion {
  evento_id bigint [ref: > evento_exogeno.evento_id]
  servicio_sentido_id int [ref: > dim_servicio_sentido.servicio_sentido_id, note: 'NULL = todos']
  periodo_id smallint [ref: > dim_periodo.periodo_id]
  Note: 'PENDIENTE (aún no implementada). SSPD excluidos por evento complejo, mayor o tecnológico mayor.'
}

Table factor_dia {
  fecha date [pk, ref: > dim_fecha.fecha]
  feo decimal(8,5) [not null, note: 'FEO d, >= 1']

  Note: 'PENDIENTE (aún no implementada). Factor por Eventos Operacionales del día. FT_offline vive en parametro.'
}

// ───────────────────────────── icfp ─────────────────────────────

Table icfp_sspd {
  calculo_id bigint [ref: > calculo.calculo_id]
  fecha date
  codigo_ts varchar(20) [note: 'normalizado: sin espacios, mayúsculas']
  sentido char(1) [note: 'I / R']
  periodo tinyint [note: 'hora de despacho 0-23 (como indicadores-bi y el DTPM)']
  mes date [not null]
  tipo_dia varchar(10) [not null, note: 'el de las velocidades del día']
  codigo_usuario varchar(20)
  terminal varchar(60) [note: 'de dim_servicio_terminal']
  ep int [note: 'expediciones programadas (Σ de las dos MH)']
  ev int [not null, note: 'válidas DESPUÉS del trasvasije']
  pl_prog int
  pl_val int [note: 'NULL si alguna expedición no tiene plazas en dim_bus']
  icf decimal(10,6)
  icp decimal(10,6)
  feo decimal(8,5) [default: 1]
  ft decimal(8,5) [default: 1]
  km_programados decimal(12,3) [not null, note: 'Σ distancia base · salidas de cada MH']
  km_validos decimal(12,3) [note: 'min(1, icf·FEO·FT, icp·FEO·FT) · kmp; NULL si SIN_CAPACIDAD']
  ev_inicial int [not null]
  pl_val_inicial int
  icf_inicial decimal(10,6)
  icp_inicial decimal(10,6)
  km_validos_inicial decimal(12,3)
  expediciones_recibidas int [not null]
  expediciones_cedidas int [not null]
  excluido boolean [not null, default: false, note: 'hoja ICFP-IE del DTPM']
  estado varchar(20) [not null, note: 'OK | SIN_EXIGENCIA | SIN_PROGRAMA | SIN_CAPACIDAD | EXCLUIDO']

  indexes {
    (calculo_id, fecha, codigo_ts, sentido, periodo) [pk]
    (fecha, calculo_id) [name: 'ix_icfp_fecha']
    (calculo_id, mes, terminal) [name: 'ix_icfp_mes']
  }
  Note: '''Grano: servicio-sentido-hora-día (5.3.1.6), equivale a bi.icfp_data.
ev, pl_val, icf, icp y km_validos son DESPUÉS del trasvasije; *_inicial es la foto antes de corregir.
ICFP = Σ km_validos / Σ km_programados, con excluido = 0 y km_validos no nulo.
Km con derecho a pago (mes) = Σ km_programados (incluidas excluidas) · ICFP del mes.'''
}

Table icfp_expedicion {
  calculo_id bigint [ref: > calculo.calculo_id]
  raw_velocidades_id bigint [ref: > raw_velocidades.id]
  fecha date [not null]
  codigo_ts varchar(20) [not null]
  sentido char(1) [not null]
  tipo_dia varchar(10) [not null]
  periodo tinyint [not null]
  fh_salida datetime [not null]
  patente varchar(12)
  tipo_bus varchar(40)
  plazas smallint
  estado_plazas varchar(15) [not null, note: 'OK | SIN_BUS | SIN_CAPACIDAD']
  fecha_asignada date [not null]
  periodo_asignado tinyint [not null, note: 'distinto de periodo si hubo trasvasije']

  indexes {
    (calculo_id, raw_velocidades_id) [pk]
  }
  Note: 'Expediciones válidas (estado OK en velocidades) usadas por el cálculo.'
}

Table icfp_trasvasije {
  calculo_id bigint [ref: > calculo.calculo_id]
  raw_velocidades_id bigint [ref: > raw_velocidades.id]
  codigo_ts varchar(20) [not null]
  sentido char(1) [not null]
  fecha_origen date [not null]
  periodo_origen tinyint [not null]
  fecha_destino date [not null, note: 'puede ser d-1 o d+1']
  periodo_destino tinyint [not null]
  regla varchar(15) [not null, note: 'PRIMERA_5_MIN (a la hora anterior) | ULTIMA_5_MIN (a la siguiente)']
  plazas smallint [not null]

  indexes {
    (calculo_id, raw_velocidades_id) [pk]
  }
  Note: 'Corrección en extremos de periodos (5.3.1.6.6), igual que indicadores-bi.'
}

// ───────────────────────────── resultado ─────────────────────────────

Table resultado_indicador {
  resultado_id bigint [pk, increment]
  calculo_id bigint [not null, ref: > calculo.calculo_id]
  nivel varchar(20) [not null, note: 'MES | DIA | SERVICIO_SENTIDO_MES | SSP_MES ...']
  mes date [not null]
  fecha date [note: 'si nivel diario']
  servicio_sentido_id int [ref: > dim_servicio_sentido.servicio_sentido_id]
  periodo_id smallint [ref: > dim_periodo.periodo_id]
  numerador decimal(18,6)
  denominador decimal(18,6)
  valor decimal(18,8)

  indexes {
    (calculo_id, nivel, mes) [name: 'ix_resultado_nivel']
  }
  Note: 'PENDIENTE (aún no implementada). Resultados agregados de cualquier indicador. Superset lee de aquí (vía vistas del último cálculo).'
}

// ───────────────────────────── vistas para Superset ─────────────────────────────

Table v_calculo_vigente {
  indicador varchar(20)
  fecha date
  calculo_id bigint [note: 'último calculo OK (PROVISORIO/DEFINITIVO) que cubre esa fecha']
  Note: 'VISTA: resuelve por fecha, no por mes, para que recalcular un rango no obligue a recalcular todo el mes.'
}

Table v_icfp_dashboard {
  calculo_id bigint [note: 'el de v_calculo_vigente para cada fecha']
  mes date
  fecha date
  tipo_dia varchar(10)
  terminal varchar(60)
  servicio varchar(20) [note: 'código usuario']
  codigo_ts varchar(20)
  sentido char(1)
  periodo varchar(20)
  ep int
  ev int
  pl_prog int
  pl_val int
  icf decimal(8,6)
  icp decimal(8,6)
  km_programados decimal(12,3)
  km_validos decimal(12,3)
  km_validos_inicial decimal(12,3)
  excluido boolean
  tipo_exclusion varchar(30) [note: 'tipo del evento exógeno']
  categoria_exclusion varchar(60)
  Note: 'VISTA (no tabla): icfp_sspd del último cálculo + nombres de terminal, servicio, periodo y evento. Superset agrega con las fórmulas de icfp_sspd.'
}

Table v_icfp_mes {
  mes date
  terminal varchar(60) [note: 'opcional: la vista agrupa también por terminal']
  km_programados_total decimal(14,3) [note: 'Σ kmp, incluidas excluidas']
  km_programados_medidos decimal(14,3) [note: 'Σ kmp con excluido = 0']
  km_validos decimal(14,3) [note: 'Σ kmv (corregido) con excluido = 0']
  icfp decimal(8,6) [note: 'km_validos / km_programados_medidos']
  km_derecho_pago decimal(14,3) [note: 'km_programados_total · icfp (contrato 5.3.1.5, parte PO)']
  km_excluidos decimal(14,3) [note: 'Σ kmp con excluido = 1']
  Note: 'VISTA mensual del ICFP y los km con derecho a pago (Contrato 5.3.1.5 y 5.3.1.6).'
}

TableGroup control {
  tipo_archivo
  control_carga
  vigencia_archivo
  indicador_fuente
  recalculo_pendiente
  indicador
  calculo
  calculo_entrada
  parametro
}

TableGroup raw {
  raw_flota
  raw_anexo1
  raw_anexo3
  raw_velocidades
  raw_exclusiones
}

TableGroup maestros {
  dim_servicio_terminal
  dim_servicio_sentido
  dim_fecha
  dim_tipologia_bus
  dim_bus
  dim_periodo
}

TableGroup programa {
  programa_periodo
  programa_periodo_tipologia
}

TableGroup operacion {
  expedicion
  evento_exogeno
  evento_exclusion
  factor_dia
}

TableGroup icfp {
  icfp_expedicion
  icfp_sspd
  icfp_trasvasije
}

TableGroup resultado {
  resultado_indicador
  v_calculo_vigente
  v_icfp_dashboard
  v_icfp_mes
}
