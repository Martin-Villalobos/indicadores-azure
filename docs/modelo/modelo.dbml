// Modelo de datos de indicadores-azure (MySQL).
// Fuente de verdad del diagrama: editar aquí y regenerar modelo.svg (ver README.md).
// Ver en vivo: pegar este archivo en https://dbdiagram.io/d
//
// Capas:
//   control   -> qué archivo entró y qué cálculo se corrió con qué entradas
//   raw       -> archivos tal como vienen (una tabla por tipo de archivo)
//   maestros  -> dimensiones compartidas por todos los indicadores
//   programa  -> lo exigido por el PO / PE (Anexo 3), resuelto por fecha
//   operacion -> lo realizado (expediciones) y los eventos exógenos
//   icfp      -> detalle propio del ICFP (Contrato 5.3.1.6)
//   resultado -> tabla genérica de resultados para cualquier indicador
//
// Para sumar un indicador nuevo: una fila en `indicador`, sus parámetros en
// `parametro`, sus entradas raw si son nuevas, una tabla de detalle propia si
// la necesita (como icfp_sspd) y sus agregados en `resultado_indicador`.

Project indicadores_azure {
  database_type: 'MySQL'
  Note: 'Cálculo de indicadores del contrato (ICFP primero) a partir de archivos DTPM.'
}

// ───────────────────────────── control ─────────────────────────────

Enum estado_carga {
  PROCESANDO
  COMPLETADO
  ERROR
}

Enum estado_calculo {
  EN_CURSO
  PROVISORIO [note: 'calculado con datos incompletos o antes del cierre del mes']
  DEFINITIVO
  ERROR
  REEMPLAZADO
}

Table control_carga {
  carga_id bigint [pk, increment]
  tipo_archivo varchar(40) [not null, note: 'ANEXO1, ANEXO3, VELOCIDADES, EVENTOS_EXOGENOS, ...']
  nombre_archivo varchar(255) [not null]
  blob_nombre varchar(400) [not null]
  hash_sha256 char(64) [not null]
  estado estado_carga [not null]
  subido_por varchar(255)
  inicio_at datetime [not null]
  fin_at datetime
  filas_leidas int
  filas_cargadas int
  mensaje_error text

  indexes {
    (tipo_archivo, hash_sha256) [unique, name: 'uq_control_carga_tipo_hash']
    (estado, inicio_at) [name: 'ix_control_carga_estado']
  }
  Note: 'Un registro por archivo procesado por el job (tipo + contenido).'
}

Table indicador {
  indicador_id smallint [pk, increment]
  codigo varchar(20) [not null, unique, note: 'ICFP, ITE, IE, IP, IPK, ICB, IKB...']
  nombre varchar(200) [not null]
  origen varchar(20) [not null, note: 'CONTRATO | INTERNO']
  referencia varchar(200) [note: 'cláusula, p. ej. Contrato 5.3.1.6']
  granularidad_base varchar(40) [note: 'p. ej. SSPD = servicio-sentido-periodo-día']
  activo boolean [not null, default: true]
  Note: 'Catálogo de indicadores. Agregar uno nuevo es agregar una fila aquí.'
}

Table calculo {
  calculo_id bigint [pk, increment]
  indicador_id smallint [not null, ref: > indicador.indicador_id]
  unidad_servicio_id smallint [not null, ref: > dim_unidad_servicio.unidad_servicio_id]
  fecha_desde date [not null]
  fecha_hasta date [not null]
  version_algoritmo varchar(50) [not null]
  parametros json [not null, note: 'foto de los parámetros usados']
  estado estado_calculo [not null]
  inicio_at datetime [not null]
  fin_at datetime
  mensaje_error text

  indexes {
    (indicador_id, unidad_servicio_id, fecha_desde) [name: 'ix_calculo_indicador']
  }
  Note: 'Cada corrida de un indicador. Nunca se sobrescribe: un recálculo es un calculo nuevo.'
}

Table calculo_entrada {
  calculo_id bigint [ref: > calculo.calculo_id]
  carga_id bigint [ref: > control_carga.carga_id]
  rol varchar(40) [not null, note: 'PROGRAMA, VELOCIDADES, EVENTOS...']

  indexes {
    (calculo_id, carga_id) [pk]
  }
  Note: 'Qué archivos entraron a cada cálculo (trazabilidad).'
}

Table parametro {
  parametro_id int [pk, increment]
  indicador_id smallint [ref: > indicador.indicador_id, note: 'NULL = parámetro común']
  nombre varchar(40) [not null, note: 'FT_OFFLINE, PLAZAS_A, X_IE1, A_ITE...']
  unidad_servicio_id smallint [ref: > dim_unidad_servicio.unidad_servicio_id, note: 'NULL = todas']
  vigente_desde date [not null]
  vigente_hasta date
  valor decimal(18,10) [not null]
  fuente varchar(200)

  indexes {
    (nombre, unidad_servicio_id, vigente_desde) [unique]
  }
  Note: 'Generaliza dim_parametro_ite: constantes con vigencia (pueden cambiar por oficio).'
}

// ───────────────────────────── raw ─────────────────────────────

Table raw_anexo1 {
  id bigint [pk, increment]
  carga_id bigint [not null, ref: > control_carga.carga_id]
  numero_fila int [not null]
  unidad_servicios varchar(40)
  anio smallint
  codigo_ts_servicio varchar(20) [not null]
  codigo_usuario_servicio varchar(20)
  sentido varchar(20) [not null]
  tipo_dia varchar(20) [not null]
  tramo_horario smallint
  hora_inicio time [not null]
  hora_termino time
  fecha_inicio date
  fecha_termino date

  indexes {
    carga_id [name: 'ix_raw_anexo1_carga']
    (codigo_ts_servicio, sentido, tipo_dia) [name: 'ix_raw_anexo1_servicio']
  }
  Note: 'Anexo 1 tal como viene en el archivo, una fila por tramo.'
}

Table raw_anexo3 {
  id bigint [pk, increment]
  carga_id bigint [not null, ref: > control_carga.carga_id]
  numero_fila int [not null]
  unidad_de_servicio varchar(40)
  fecha_inicio date [note: 'vigencia según nombre/hoja del archivo']
  fecha_termino date
  codigo_ts_servicio varchar(20) [not null]
  codigo_usuario_servicio varchar(20)
  sentido varchar(20) [not null]
  tipo_dia varchar(20) [not null]
  mh time [not null, note: 'media hora']
  velocidad_km_hora decimal(8,2)
  distancia_base_km decimal(10,3)
  distancia_total_km decimal(10,3)
  numero_salidas int
  capacidad_plazas int
  agrupacion_mh varchar(40)
  familia_servicios varchar(40)
  indicador_tiempo_espera varchar(10)
  Note: 'Anexo 3 del PO o de un Programa Especial, una fila por media hora.'
}

Table raw_velocidades {
  id bigint [pk, increment]
  carga_id bigint [not null, ref: > control_carga.carga_id]
  numero_fila int [not null]
  un varchar(20)
  fecha date [not null]
  tipo_dia varchar(20)
  servicio varchar(20)
  sentido varchar(20)
  patente varchar(10)
  inicio time
  control time
  fin time
  tiempo varchar(20)
  distancia_m decimal(14,3)
  velocidad_km_hr decimal(12,4)
  estado varchar(10) [note: 'OK / NOK...']
  periodo varchar(30)
  Note: 'Archivo diario de velocidades DTPM, una fila por expedición.'
}

Table raw_eventos_exogenos {
  id bigint [pk, increment]
  carga_id bigint [not null, ref: > control_carga.carga_id]
  numero_fila int [not null]
  fecha date
  tipo_evento varchar(60)
  servicio varchar(20)
  sentido varchar(20)
  hora_desde time
  hora_hasta time
  resolucion_dtpm varchar(40) [note: 'aceptado / rechazado']
  observacion text
  Note: 'Respuesta DTPM a eventos exógenos (y eventos complejos propios). Columnas a confirmar con el archivo real.'
}

// ───────────────────────────── maestros ─────────────────────────────

Table dim_unidad_servicio {
  unidad_servicio_id smallint [pk, increment]
  codigo varchar(10) [not null, unique, note: 'U16']
  nombre varchar(100)
}

Table dim_servicio_sentido {
  servicio_sentido_id int [pk, increment]
  unidad_servicio_id smallint [not null, ref: > dim_unidad_servicio.unidad_servicio_id]
  codigo_ts varchar(20) [not null, note: 'normalizado: sin espacios, mayúsculas']
  codigo_usuario varchar(20)
  sentido char(1) [not null, note: 'I / R']

  indexes {
    (unidad_servicio_id, codigo_ts, sentido) [unique]
  }
  Note: 's del contrato. Normaliza el código una sola vez para que anexo y velocidades crucen.'
}

Table dim_fecha {
  fecha date [pk]
  mes date [not null, note: 'primer día del mes (T)']
  dia_semana tinyint [not null]
  tipo_dia_calendario varchar(10) [not null, note: 'LABORAL / SABADO / DOMINGO (feriado = DOMINGO)']
  es_feriado boolean [not null, default: false]
  Note: 'Calendario. El tipo de día operativo final sale de programa_dia.'
}

Table dim_tipologia_bus {
  tipologia varchar(5) [pk, note: 'A1, A2, B1, B2, C1, C2']
  plazas smallint [not null, note: 'Contrato Tabla 5: A=60, B=90, C=150']
}

Table dim_bus {
  bus_id int [pk, increment]
  ppu varchar(10) [not null]
  tipologia varchar(5) [not null, ref: > dim_tipologia_bus.tipologia]
  terminal varchar(60)
  vigente_desde date [not null]
  vigente_hasta date

  indexes {
    (ppu, vigente_desde) [unique]
  }
  Note: 'Flota con historia (hoy bi.buses no tiene fechas).'
}

Table dim_periodo {
  periodo_id smallint [pk, increment]
  esquema varchar(20) [not null, note: 'HORA (como el Java) | PO (agrupación MH del contrato)']
  codigo varchar(20) [not null]
  hora_inicio time [not null]
  hora_termino time [not null]
  orden smallint [not null, note: 'para ubicar p-1 y p+1']

  indexes {
    (esquema, codigo) [unique]
  }
  Note: 'p del contrato. El esquema deja cambiar de hora a periodos del PO sin tocar el resto.'
}

// ───────────────────────────── programa ─────────────────────────────

Table programa {
  programa_id int [pk, increment]
  carga_id bigint [not null, ref: > control_carga.carga_id]
  unidad_servicio_id smallint [not null, ref: > dim_unidad_servicio.unidad_servicio_id]
  tipo varchar(10) [not null, note: 'PO | PE (programa especial)']
  vigente_desde date [not null]
  vigente_hasta date [not null]
  prioridad smallint [not null, note: 'el de mayor prioridad gana en una fecha']
  activo boolean [not null, default: true]
  Note: 'Cada Anexo 3 cargado (PO base o PE de uno o pocos días).'
}

Table programa_dia {
  fecha date [ref: > dim_fecha.fecha]
  unidad_servicio_id smallint [ref: > dim_unidad_servicio.unidad_servicio_id]
  programa_id int [not null, ref: > programa.programa_id]
  tipo_dia varchar(10) [not null, note: 'tipo de día que aplica ese día']

  indexes {
    (fecha, unidad_servicio_id) [pk]
  }
  Note: 'Resuelve qué programa y tipo de día rige cada fecha. Se materializa al cargar un PO/PE.'
}

Table programa_periodo {
  programa_periodo_id bigint [pk, increment]
  programa_id int [not null, ref: > programa.programa_id]
  servicio_sentido_id int [not null, ref: > dim_servicio_sentido.servicio_sentido_id]
  tipo_dia varchar(10) [not null]
  periodo_id smallint [not null, ref: > dim_periodo.periodo_id]
  longitud_km decimal(10,3) [not null, note: 'L s,p']
  expediciones_programadas int [not null, note: 'Σb ep']
  plazas_programadas int [not null, note: 'Σb pl_prog']

  indexes {
    (programa_id, servicio_sentido_id, tipo_dia, periodo_id) [unique]
  }
  Note: 'Exigencia por servicio-sentido-periodo y tipo de día (agrupa las medias horas del Anexo 3).'
}

Table programa_periodo_tipologia {
  programa_periodo_id bigint [ref: > programa_periodo.programa_periodo_id]
  tipologia varchar(5) [ref: > dim_tipologia_bus.tipologia]
  expediciones_programadas int [not null, note: 'ep b,s,p']

  indexes {
    (programa_periodo_id, tipologia) [pk]
  }
  Note: 'Opcional: desglose por tipo de bus (lo pide km válidos por tipo de bus / PKS).'
}

// ───────────────────────────── operacion ─────────────────────────────

Table expedicion {
  expedicion_id bigint [pk, increment]
  raw_velocidades_id bigint [not null, ref: > raw_velocidades.id]
  fecha date [not null, ref: > dim_fecha.fecha]
  servicio_sentido_id int [not null, ref: > dim_servicio_sentido.servicio_sentido_id]
  bus_id int [ref: > dim_bus.bus_id, note: 'NULL si la patente no está en la flota']
  fh_salida datetime [not null]
  fh_llegada datetime
  periodo_id smallint [not null, ref: > dim_periodo.periodo_id, note: 'periodo de despacho']
  valida boolean [not null, note: 'cláusula 1.1.22']
  motivo_invalidez varchar(40)
  plazas smallint [note: 'según tipología del bus']

  indexes {
    (fecha, servicio_sentido_id, periodo_id) [name: 'ix_expedicion_sspd']
  }
  Note: 'Expedición realizada, normalizada y ya cruzada con flota. La comparten ICFP, ITE, IPK, Telemetría km...'
}

Table evento_exogeno {
  evento_id bigint [pk, increment]
  carga_id bigint [ref: > control_carga.carga_id]
  fecha date [not null, ref: > dim_fecha.fecha]
  unidad_servicio_id smallint [not null, ref: > dim_unidad_servicio.unidad_servicio_id]
  tipo varchar(30) [not null, note: 'TECNOLOGICO_MAYOR | OPERACIONAL_SIMPLE | OPERACIONAL_COMPLEJO | OPERACIONAL_MAYOR']
  categoria varchar(60) [note: 'p. ej. Tráfico Recargado (define el aporte al FEO)']
  aceptado boolean [not null]
  observacion text
  Note: 'Eventos exógenos aceptados por DTPM (Manual de Eventos Exógenos).'
}

Table evento_exclusion {
  evento_id bigint [ref: > evento_exogeno.evento_id]
  servicio_sentido_id int [ref: > dim_servicio_sentido.servicio_sentido_id, note: 'NULL = todos']
  periodo_id smallint [ref: > dim_periodo.periodo_id]
  Note: 'SSPD excluidos por evento complejo, mayor o tecnológico mayor.'
}

Table factor_dia {
  fecha date [ref: > dim_fecha.fecha]
  unidad_servicio_id smallint [ref: > dim_unidad_servicio.unidad_servicio_id]
  feo decimal(8,5) [not null, note: 'FEO d, >= 1']

  indexes {
    (fecha, unidad_servicio_id) [pk]
  }
  Note: 'Factor por Eventos Operacionales del día. FT_offline vive en parametro.'
}

// ───────────────────────────── icfp ─────────────────────────────

Table icfp_sspd {
  calculo_id bigint [ref: > calculo.calculo_id]
  fecha date [ref: > dim_fecha.fecha]
  servicio_sentido_id int [ref: > dim_servicio_sentido.servicio_sentido_id]
  periodo_id smallint [ref: > dim_periodo.periodo_id]
  programa_periodo_id bigint [ref: > programa_periodo.programa_periodo_id]
  ep int [not null, note: 'expediciones programadas']
  ev int [not null, note: 'expediciones válidas, tras trasvasije']
  pl_prog int [not null]
  pl_val int [not null]
  km_prog decimal(12,3) [not null, note: 'kmp = L · ep']
  icf decimal(8,6) [note: 'min(1, ev/ep)']
  icp decimal(8,6) [note: 'min(1, pl_val/pl_prog)']
  feo decimal(8,5)
  ft decimal(8,5)
  km_validos decimal(12,3) [note: 'min(icf·FEO·FT, icp·FEO·FT) · kmp']
  excluido boolean [not null, default: false]
  evento_id bigint [ref: > evento_exogeno.evento_id, note: 'si excluido']
  estado varchar(20) [not null, note: 'OK | SIN_EXIGENCIA | SIN_PROGRAMA | SIN_CAPACIDAD']

  indexes {
    (calculo_id, fecha, servicio_sentido_id, periodo_id) [pk]
  }
  Note: 'Detalle del ICFP por servicio-sentido-periodo-día (Contrato 5.3.1.6.1 a 5.3.1.6.5).'
}

Table icfp_trasvasije {
  calculo_id bigint [ref: > calculo.calculo_id]
  expedicion_id bigint [ref: > expedicion.expedicion_id]
  periodo_origen_id smallint [not null, ref: > dim_periodo.periodo_id]
  periodo_destino_id smallint [not null, ref: > dim_periodo.periodo_id]
  fecha_destino date [not null, note: 'puede ser d-1 o d+1']
  regla varchar(10) [not null, note: 'ANTERIOR | POSTERIOR']

  indexes {
    (calculo_id, expedicion_id) [pk]
  }
  Note: 'Corrección en extremos de periodos (5.3.1.6.6).'
}

// ───────────────────────────── resultado ─────────────────────────────

Table resultado_indicador {
  resultado_id bigint [pk, increment]
  calculo_id bigint [not null, ref: > calculo.calculo_id]
  nivel varchar(20) [not null, note: 'MES | DIA | SERVICIO_SENTIDO_MES | SSP_MES ...']
  mes date [not null]
  fecha date [note: 'si nivel diario']
  servicio_sentido_id int [ref: > dim_servicio_sentido.servicio_sentido_id]
  periodo_id smallint [ref: > dim_periodo.periodo_id]
  numerador decimal(18,6)
  denominador decimal(18,6)
  valor decimal(18,8)

  indexes {
    (calculo_id, nivel, mes) [name: 'ix_resultado_nivel']
  }
  Note: 'Resultados agregados de cualquier indicador. Superset lee de aquí (vía vistas del último cálculo).'
}

TableGroup control {
  control_carga
  indicador
  calculo
  calculo_entrada
  parametro
}

TableGroup raw {
  raw_anexo1
  raw_anexo3
  raw_velocidades
  raw_eventos_exogenos
}

TableGroup maestros {
  dim_unidad_servicio
  dim_servicio_sentido
  dim_fecha
  dim_tipologia_bus
  dim_bus
  dim_periodo
}

TableGroup programa {
  programa
  programa_dia
  programa_periodo
  programa_periodo_tipologia
}

TableGroup operacion {
  expedicion
  evento_exogeno
  evento_exclusion
  factor_dia
}

TableGroup icfp {
  icfp_sspd
  icfp_trasvasije
}

TableGroup resultado {
  resultado_indicador
}
